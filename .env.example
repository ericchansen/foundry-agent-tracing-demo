# Azure OpenAI resource endpoint (classic resource)
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com

# Model deployment name (must support Assistants API — use gpt-4o, NOT gpt-5.4)
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Azure subscription ID (used for Log Analytics query)
AZURE_SUBSCRIPTION_ID=

# Log Analytics workspace ID (from: az monitor log-analytics workspace show --query customerId)
LOG_ANALYTICS_WORKSPACE_ID=

# Optional: use API key auth instead of Azure AD (only if disableLocalAuth=false)
# AZURE_OPENAI_API_KEY=
